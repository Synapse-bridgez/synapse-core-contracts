#!/usr/bin/env sh
# Pre-commit hook — mirrors the fmt + clippy steps in CI.
#
# Install once per clone:
#   git config core.hooksPath .git-hooks
#
# What it checks:
#   1. cargo fmt --check   — formatting must match rustfmt.toml
#   2. cargo clippy        — no warnings allowed (same flags as CI)

set -e

echo "==> cargo fmt --check"
if ! cargo fmt --all -- --check; then
    echo "" >&2
    echo "ERROR: formatting check failed." >&2
    echo "Fix it by running: cargo fmt" >&2
    exit 1
fi

echo "==> cargo clippy"
if ! cargo clippy --all-targets -- -D warnings; then
    echo "" >&2
    echo "ERROR: clippy check failed." >&2
    echo "Try auto-fixing with: cargo clippy --fix --all-targets --allow-dirty --allow-staged" >&2
    echo "Then re-run: cargo clippy --all-targets -- -D warnings" >&2
    exit 1
fi

echo "Pre-commit checks passed."

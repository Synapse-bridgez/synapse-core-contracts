#!/usr/bin/env sh
# Pre-commit hook — mirrors the fmt + clippy steps in CI.
#
# Install once per clone:
#   git config core.hooksPath .git-hooks
#
# What it checks:
#   1. cargo fmt --check   — formatting must match rustfmt.toml
#   2. cargo clippy        — no warnings allowed (same flags as CI)

set -e

if ! cargo fmt --all -- --check; then
    echo "pre-commit: cargo fmt --check failed" >&2
    echo "pre-commit: run 'cargo fmt' to fix formatting, then re-stage your changes." >&2
    exit 1
fi

if ! cargo clippy --all-targets -- -D warnings; then
    echo "pre-commit: cargo clippy failed" >&2
    echo "pre-commit: fix the warnings above (run 'cargo clippy --all-targets -- -D warnings' to reproduce)." >&2
    exit 1
fi

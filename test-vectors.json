    {
      "id": "reg-007",
      "description": "register_callback() transaction_id over 64-byte cap — StringTooLong",
      "category": "validation",
      "entry_point": "register_callback",
      "inputs": {
        "transaction_id": "ttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttttt"

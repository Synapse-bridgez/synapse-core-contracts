            "synapse",
            "pause"
          ],
          "present": true
        }
      ],
      "expected_state": {
        "paused": true
      },
      "notes": [
        "R-01 compensating control: pause halts new ingestion",
        "Status transitions intentionally still work while paused (draining in-flight work)"
      ]
    },
    {
      "id": "pause-002",
      "description": "unpause() by admin — resumes register_callback, emits pause event",
      "category": "pause",
      "entry_point": "unpause",

    {
      "id": "proc-001",
      "description": "start_processing() on Pending transaction — transitions to Processing",
      "category": "lifecycle",
      "entry_point": "start_processing",
      "inputs": {
        "caller": "<relay_or_admin_address>",
        "tx_id": "tx-uuid-001"
      },
      "pre_state": {
        "transaction.status": "Pending"
      },
      "expected_result": "ok",
      "expected_events": [
        {
          "topics": [
            "synapse",
            "status"
          ],
          "present": true
        }
      ],
      "expected_state": {
        "transaction.status": "Processing"
      },
      "notes": [
        "I-02: only Pending→Processing is valid here"
      ]
    },
    {
      "id": "proc-002",
      "description": "start_processing() on Completed transaction — InvalidStatusTransition",
      "category": "lifecycle",
      "entry_point": "start_processing",
      "inputs": {
        "caller": "<relay_or_admin_address>",
        "tx_id": "tx-uuid-001"
      },
      "pre_state": {
        "transaction.status": "Completed"
      },
      "expected_result": "err:InvalidStatusTransition",
      "expected_events": [],
      "expected_state": {
        "transaction.status": "Completed"
      },
      "notes": [
        "I-05: Completed is terminal",
        "ContractError::InvalidStatusTransition = 31"
      ]
    },
    {

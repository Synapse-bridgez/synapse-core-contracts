        "caller_is_relay": false,
        "transaction.status": "Pending"
      },
      "expected_result": "err:Unauthorised",
      "expected_events": [],
      "expected_state": {
        "transaction.status": "Pending"
      },
      "notes": [
        "ContractError::Unauthorised = 10"
      ]
    },
    {
      "id": "comp-001",
      "description": "complete_transaction() on Processing — Completed, fee accrued (100 bps on 1_000_000)",
      "category": "lifecycle",
      "entry_point": "complete_transaction",
      "inputs": {
        "caller": "<relay_or_admin_address>",
        "stellar_tx_hash": "abc123stellarhash",
        "tx_id": "tx-uuid-001"
      },
      "pre_state": {
        "param.base_fee_bps": "100",
        "transaction.amount": "1000000",
        "transaction.status": "Processing",
        "treasury_balance": "0"
      },
      "expected_result": "ok",
      "expected_events": [
        {
          "topics": [
            "synapse",
            "status"
          ],
          "present": true
        },
        {
          "topics": [
            "synapse",
            "done"
          ],
          "present": true
        },
        {
          "topics": [
            "synapse",
            "fee"
          ],
          "present": true
        }
      ],
      "expected_state": {
        "transaction.status": "Completed",
        "transaction.stellar_tx_hash": "abc123stellarhash",
        "treasury_balance": "10000"
      },
      "notes": [
        "I-03: Processing→Completed is the only valid transition",
        "I-10: stellar_tx_hash set at Completed",
        "fee = floor(1_000_000 * 100 / 10_000) = 10_000 stroops",
        "#141 fee accrual",
        "Events emitted in order: status, done, fee"
      ]
    },
    {
      "id": "comp-002",
      "description": "complete_transaction() with base_fee_bps=0 — Completed, no fee event",
      "category": "fee",
      "entry_point": "complete_transaction",
      "inputs": {
        "caller": "<relay_or_admin_address>",
        "stellar_tx_hash": "abc123stellarhash",
        "tx_id": "tx-uuid-001"
      },
      "pre_state": {
        "param.base_fee_bps": "0",
        "transaction.status": "Processing",
        "treasury_balance": "0"
      },
      "expected_result": "ok",
      "expected_events": [
        {
          "topics": [
            "synapse",
            "status"
          ],
          "present": true
        },
        {
          "topics": [
            "synapse",
            "done"
          ],
          "present": true
        },
        {
          "topics": [
            "synapse",
            "fee"
          ],
          "present": false
        }
      ],
      "expected_state": {
        "transaction.status": "Completed",
        "treasury_balance": "0"
      },
      "notes": [
        "With base_fee_bps=0 (or unset), no fee is accrued and no fee event is emitted",
        "Events emitted: exactly 2 (status, done)"
      ]
    },
    {
      "id": "comp-003",
      "description": "complete_transaction() on Pending (skipping Processing) — InvalidStatusTransition",
      "category": "lifecycle",
      "entry_point": "complete_transaction",
      "inputs": {
        "caller": "<relay_or_admin_address>",
        "stellar_tx_hash": "abc123stellarhash",
        "tx_id": "tx-uuid-001"
      },
      "pre_state": {
        "transaction.status": "Pending"
      },
      "expected_result": "err:InvalidStatusTransition",
      "expected_events": [],
      "expected_state": {
        "transaction.status": "Pending"
      },
      "notes": [
        "State machine strictly enforced: Pending→Completed is not a valid transition"
      ]
    },
    {
      "id": "fail-001",
      "description": "fail_transaction() on Pending — Failed, no fee accrued",
      "category": "lifecycle",
      "entry_point": "fail_transaction",
      "inputs": {
        "caller": "<relay_or_admin_address>",
        "reason": "horizon_timeout",
        "tx_id": "tx-uuid-001"
      },
      "pre_state": {
        "param.base_fee_bps": "100",
        "transaction.status": "Pending",
        "treasury_balance": "0"
      },
      "expected_result": "ok",
      "expected_events": [
        {
          "topics": [
            "synapse",
            "status"
          ],
          "present": true
        },
        {
          "topics": [
            "synapse",
            "fail"
          ],
          "present": true
        }
      ],
      "expected_state": {
        "transaction.failure_reason": "horizon_timeout",
        "transaction.status": "Failed",
        "treasury_balance": "0"
      },
      "notes": [
        "I-04: Pending→Failed is valid",
        "I-11: failure_reason set at Failed",
        "No fee accrual on Failed — fees only on Completed"
      ]
    },
    {
      "id": "fail-002",
      "description": "fail_transaction() on Completed — InvalidStatusTransition",
      "category": "lifecycle",
      "entry_point": "fail_transaction",
      "inputs": {
        "caller": "<relay_or_admin_address>",
        "reason": "late-fail",
        "tx_id": "tx-uuid-001"
      },
      "pre_state": {
        "transaction.status": "Completed"
      },
      "expected_result": "err:InvalidStatusTransition",
      "expected_events": [],
      "expected_state": {
        "transaction.status": "Completed"
      },
      "notes": [
        "I-05: Completed is terminal — cannot be failed after completion"
      ]
    },

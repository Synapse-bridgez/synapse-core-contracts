{
  "schema_version": 1,
  "contract_version": "0.1.0",
  "description": "Language-agnostic test vectors for synapse-core-contract. Each vector specifies entry-point inputs, required pre-state, expected result, expected events, and expected post-state. An external auditor can replay these against a deployed contract instance using any tooling that can invoke Soroban contract methods and read ledger state/events.",
  "reference_docs": [
    "THREAT_MODEL.md",
    "EVENTS.md",
    "docs/adr/0001-relay-signer-trust-model.md",
    "docs/adr/0002-two-step-admin-transfer.md",
    "docs/adr/0003-upgrade-schema-version-guard.md",
    "docs/adr/0008-fee-accrual-and-treasury-withdrawal.md",
    "docs/test-vectors.md"
  ],
  "vectors": [
    {
      "id": "init-001",
      "description": "initialize() with valid admin and relay — succeeds and sets state",
      "category": "initialisation",
      "entry_point": "initialize",
      "inputs": {
        "admin": "<admin_address>",
        "relay_signer": "<relay_address>"
      },
      "pre_state": {
        "initialized": false
      },
      "expected_result": "ok",
      "expected_events": [
        {
          "topics": [
            "synapse",
            "init"
          ],
          "present": true
        }
      ],
      "expected_state": {
        "admin": "<admin_address>",
        "initialized": true,
        "paused": false,
        "relay_signer": "<relay_address>",
        "schema_version": 1
      },
      "notes": [
        "THREAT_MODEL §4.1: double-init guard enforced",
        "I-08: contract must be initialised before state-mutating calls"
      ]
    },
    {
      "id": "init-002",
      "description": "initialize() called twice — returns AlreadyInitialised",
      "category": "initialisation",
      "entry_point": "initialize",
      "inputs": {
        "admin": "<admin_address>",
        "relay_signer": "<relay_address>"
      },
      "pre_state": {
        "initialized": true
      },
      "expected_result": "err:AlreadyInitialised",
      "expected_events": [
        {
          "topics": [
            "synapse",
            "init"
          ],
          "present": false
        }
      ],
      "expected_state": {},
      "notes": [
        "ContractError::AlreadyInitialised = 1"
      ]
    },
    {
      "id": "reg-001",
      "description": "register_callback() with valid payload — creates Pending transaction",
      "category": "lifecycle",
      "entry_point": "register_callback",
      "inputs": {
        "amount": "1000000",
        "anchor_transaction_id": "anchor-001",
        "asset_code": "USDC",
        "asset_issuer": "GA7QYNF7SOWQ3GLR2BGMZEHXAVIRZA4KVWLTJJFC7MGXUA74P7UJVSGZ",
        "callback_status": "pending_external",
        "callback_type": "Deposit",
        "idempotency_key": "idem-001",
        "stellar_account": "GA7QYNF7SOWQ3GLR2BGMZEHXAVIRZA4KVWLTJJFC7MGXUA74P7UJVSGZ",
        "transaction_id": "tx-uuid-001"
      },
      "pre_state": {
        "idempotency_known": false,
        "initialized": true,
        "paused": false,
        "transaction_exists": false
      },
      "expected_result": "ok:\"tx-uuid-001\"",
      "expected_events": [
        {
          "topics": [
            "synapse",
            "reg"
          ],
          "present": true
        }
      ],
      "expected_state": {
        "idempotency_key_recorded": true,
        "transaction.failure_reason": "",
        "transaction.status": "Pending",
        "transaction.stellar_tx_hash": ""
      },
      "notes": [
        "I-01: transaction created in Pending state",
        "I-10: stellar_tx_hash empty until Completed",
        "I-11: failure_reason empty until Failed"
      ]
    },
    {
      "id": "reg-002",
      "description": "register_callback() duplicate idempotency_key within TTL — idempotent return, no write",
      "category": "idempotency",
      "entry_point": "register_callback",
      "inputs": {
        "idempotency_key": "idem-001",
        "transaction_id": "tx-uuid-001"
      },
      "pre_state": {
        "idempotency_known": true
      },
      "expected_result": "ok:\"tx-uuid-001\"",
      "expected_events": [
        {
          "topics": [
            "synapse",
            "reg"
          ],
          "present": false
        }
      ],
      "expected_state": {},
      "notes": [
        "R-04: idempotency window finite — within window, deduplication works",
        "No second write occurs"
      ]
    },
    {
      "id": "reg-003",
      "description": "register_callback() same transaction_id after idempotency TTL expiry — DuplicateRequest (F-07)",
      "category": "idempotency",
      "entry_point": "register_callback",
      "inputs": {
        "idempotency_key": "idem-fresh-new-key",
        "transaction_id": "tx-uuid-001"
      },
      "pre_state": {
        "idempotency_known": false,
        "transaction_exists": true
      },
      "expected_result": "err:DuplicateRequest",
      "expected_events": [
        {
          "topics": [
            "synapse",
            "reg"
          ],
          "present": false
        }
      ],
      "expected_state": {},
      "notes": [
        "F-07 fixed: persistent transaction_id guard, independent of idempotency TTL",
        "R-04 compensating control",
        "ContractError::DuplicateRequest = 40"
      ]
    },
    {
      "id": "reg-004",
      "description": "register_callback() while paused — ContractPaused",
      "category": "pause",
      "entry_point": "register_callback",
      "inputs": {
        "transaction_id": "tx-any"
      },
      "pre_state": {
        "paused": true
      },
      "expected_result": "err:ContractPaused",
      "expected_events": [],
      "expected_state": {},
      "notes": [
        "ContractError::ContractPaused = 12",
        "R-01 compensating control: pause halts new ingestion"
      ]
    },
    {

      },
      "expected_result": "err:WithdrawalCapExceeded",
      "expected_events": [],
      "expected_state": {},
      "notes": [
        "ContractError::WithdrawalCapExceeded = 111",
        "epoch_withdrawn + amount > epoch_cap triggers rejection"
      ]
    },
    {
      "id": "wdraw-007",
      "description": "authorize_withdrawal() after epoch reset — cap resets, withdrawal succeeds",
      "category": "treasury",
      "entry_point": "authorize_withdrawal",
      "inputs": {
        "amount": "1",
        "caller": "<relay_address>",
        "destination": "<destination_address>"
      },
      "pre_state": {
        "caller_is_relay": true,
        "epoch_withdrawn": "1000000",
        "ledger_sequence": ">= epoch_start + treasury_epoch_length",
        "param.treasury_epoch_cap": "1000000",
        "pending_withdrawal.amount": "1"
      },
      "expected_result": "ok",
      "expected_events": [
        {
          "topics": [
            "synapse",
            "wexec"
          ],
          "present": true
        }
      ],
      "expected_state": {
        "epoch_withdrawn": "1"
      },
      "notes": [
        "Epoch resets automatically when now >= epoch_start + treasury_epoch_length",
        "epoch_withdrawn counter starts at 0 in new epoch"
      ]
    },
    {
      "id": "wdraw-008",
      "description": "set_param(treasury_epoch_length, 0) — InvalidParamValue",
      "category": "treasury",
      "entry_point": "set_param",
      "inputs": {
        "name": "treasury_epoch_length",
        "value": "0"
      },
      "pre_state": {
        "caller_is_admin": true
      },
      "expected_result": "err:InvalidParamValue",
      "expected_events": [
        {
          "topics": [
            "synapse",
            "param"
          ],
          "present": false
        }
      ],
      "expected_state": {},
      "notes": [
        "ContractError::InvalidParamValue = 71",
        "A zero-length epoch would reset the cap on every call, defeating it"
      ]
    },
    {
      "id": "wdraw-009",
      "description": "authorize_withdrawal() naming a different amount/destination than the pending proposal — WithdrawalProposalMismatch",
      "category": "treasury",
      "entry_point": "authorize_withdrawal",
      "inputs": {
        "amount": "500",
        "caller": "<relay_address>",
        "destination": "<destination_address>"
      },
      "pre_state": {
        "caller_is_relay": true,
        "pending_withdrawal.amount": "1000",
        "pending_withdrawal.destination": "<attacker_address>",
        "treasury_balance": "5000"
      },
      "expected_result": "err:WithdrawalProposalMismatch",
      "expected_events": [
        {
          "topics": [
            "synapse",
            "wexec"
          ],
          "present": false
        }
      ],
      "expected_state": {
        "pending_withdrawal_still_present": true,
        "treasury_balance": "5000"
      },
      "notes": [
        "ContractError::WithdrawalProposalMismatch = 117",
        "R-06 control (d): the relay co-signs one specific (amount, destination); an admin-side proposal swap after relay review cannot execute"
      ]
    },
    {
      "id": "pause-001",

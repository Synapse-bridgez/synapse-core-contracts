    {
      "id": "fee-004",
      "description": "complete_transaction() with amount = i128::MAX at 1 bps — exact fee, no overflow",
      "category": "fee",
      "entry_point": "complete_transaction",
      "inputs": {
        "caller": "<relay_or_admin_address>",
        "stellar_tx_hash": "abc123stellarhash",
        "tx_id": "tx-uuid-max"
      },
      "pre_state": {
        "param.base_fee_bps": "1",
        "transaction.amount": "170141183460469231731687303715884105727",
        "transaction.status": "Processing",
        "treasury_balance": "0"
      },
      "expected_result": "ok",
      "expected_events": [
        {
          "topics": [
            "synapse",
            "status"
          ],
          "present": true
        },
        {
          "topics": [
            "synapse",
            "done"
          ],
          "present": true
        },
        {
          "topics": [
            "synapse",
            "fee"
          ],
          "present": true
